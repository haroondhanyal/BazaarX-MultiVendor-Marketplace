VITE_API_URL=http://localhost:3001/api/v1
PORT=3001
DATABASE_URL=postgresql://bazaarx:bazaarx@localhost:5432/bazaarx
REDIS_URL=redis://localhost:6379
# Local demo state survives API restarts. Point this at a writable persistent volume when deployed.
MARKETPLACE_STATE_DIR=./var/state
# Optional provider adapters; each endpoint receives a POST notification payload.
NOTIFICATION_WEBHOOK_TOKEN=
EMAIL_NOTIFICATION_WEBHOOK=
SMS_NOTIFICATION_WEBHOOK=
PUSH_NOTIFICATION_WEBHOOK=
# Use postgres after applying the Prisma migrations; file mode needs no database.
PERSISTENCE_DRIVER=file
